# Server
PORT=4000
NODE_ENV=production

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-health?retryWrites=true&w=majority

# ML Service URL (Render internal or external)
FASTAPI_URL=https://smart-health-ml.onrender.com

# Device authentication key for IoT hardware
DEVICE_API_KEY=replace-me-with-a-strong-key

# JWT secret for auth tokens (use a strong random string in production)
JWT_SECRET=replace-me-with-a-strong-secret

# CORS — allowed frontend origin(s), comma-separated for multiple
CLIENT_ORIGIN=https://smart-health-frontend.onrender.com